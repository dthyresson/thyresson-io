---
import { Image } from '@unpic/astro';
import type { ImageMetadata } from 'astro';

interface Slide {
  src: ImageMetadata | string;
  alt: string;
  caption?: string;
}

interface Props {
  slides: Slide[];
  id?: string;
}

const { slides, id = 'image-gallery' } = Astro.props;
const dialogId = `${id}-lightbox`;
---

<div id={id} class="not-prose my-8">
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
    {
      slides.map((slide) => (
        <figure class="m-0">
          <button
            type="button"
            class="group block w-full cursor-zoom-in border-0 bg-transparent p-0"
            data-full={
              typeof slide.src === 'string' ? slide.src : slide.src.src
            }
            data-alt={slide.alt}
            data-caption={slide.caption ?? slide.alt}
            aria-label={`Open ${slide.caption ?? slide.alt} larger`}
          >
            <Image
              src={slide.src}
              alt={slide.alt}
              width={960}
              height={540}
              class="w-full h-auto shadow-lg transition-opacity group-hover:opacity-90"
            />
          </button>
          <figcaption class="mt-2 text-sm opacity-70">
            {slide.caption ?? slide.alt}
          </figcaption>
        </figure>
      ))
    }
  </div>

  <dialog
    id={dialogId}
    aria-label="Image preview"
    class="m-0 h-full w-full max-h-none max-w-none border-0 bg-black/95 p-4 text-white backdrop:bg-black/90"
  >
    <div class="flex h-full w-full flex-col items-center justify-center gap-3">
      <img
        id={`${dialogId}-image`}
        alt=""
        class="max-h-[80vh] max-w-full cursor-pointer touch-none select-none object-contain shadow-2xl"
      />
      <div
        class="flex flex-wrap items-center justify-center gap-3 text-sm text-white/80"
      >
        <button
          id={`${dialogId}-prev`}
          type="button"
          class="rounded border border-white/30 px-3 py-1 hover:bg-white/10"
          aria-label="Previous slide"
        >
          ←
        </button>
        <span id={`${dialogId}-caption`}></span>
        <span id={`${dialogId}-counter`} class="font-mono text-xs text-white/50"
        ></span>
        <button
          id={`${dialogId}-next`}
          type="button"
          class="rounded border border-white/30 px-3 py-1 hover:bg-white/10"
          aria-label="Next slide"
        >
          →
        </button>
        <button
          id={`${dialogId}-close`}
          type="button"
          class="rounded border border-white/30 px-3 py-1 hover:bg-white/10"
        >
          Close
        </button>
      </div>
      <p class="text-xs text-white/40">Swipe or tap the image to navigate.</p>
    </div>
  </dialog>
</div>

<script define:vars={{ galleryId: id, dialogId }}>
  const gallery = document.getElementById(galleryId);
  const dialog = document.getElementById(dialogId);
  const image = document.getElementById(`${dialogId}-image`);
  const caption = document.getElementById(`${dialogId}-caption`);
  const counter = document.getElementById(`${dialogId}-counter`);
  const prevButton = document.getElementById(`${dialogId}-prev`);
  const nextButton = document.getElementById(`${dialogId}-next`);
  const closeButton = document.getElementById(`${dialogId}-close`);

  if (
    gallery &&
    dialog &&
    image &&
    caption &&
    counter &&
    prevButton &&
    nextButton &&
    closeButton
  ) {
    const buttons = Array.from(gallery.querySelectorAll('[data-full]'));
    let current = 0;

    const show = (index) => {
      if (!buttons.length) return;
      current = (index + buttons.length) % buttons.length;
      const button = buttons[current];
      image.src = button.dataset.full || '';
      image.alt = button.dataset.alt || '';
      caption.textContent = button.dataset.caption || '';
      counter.textContent = `${current + 1} / ${buttons.length}`;
    };

    buttons.forEach((button, index) => {
      button.addEventListener('click', () => {
        show(index);
        dialog.showModal();
      });
    });

    prevButton.addEventListener('click', () => show(current - 1));
    nextButton.addEventListener('click', () => show(current + 1));

    let lastSwipeAt = 0;
    let touchStartX = 0;
    let touchStartY = 0;

    image.addEventListener('click', (event) => {
      if (Date.now() - lastSwipeAt < 350) return;
      const rect = image.getBoundingClientRect();
      const x = event.clientX - rect.left;
      show(x < rect.width / 2 ? current - 1 : current + 1);
    });

    image.addEventListener(
      'touchstart',
      (event) => {
        const touch = event.changedTouches[0];
        touchStartX = touch.clientX;
        touchStartY = touch.clientY;
      },
      { passive: true }
    );

    image.addEventListener('touchend', (event) => {
      const touch = event.changedTouches[0];
      const deltaX = touch.clientX - touchStartX;
      const deltaY = touch.clientY - touchStartY;
      if (Math.abs(deltaX) > 50 && Math.abs(deltaX) > Math.abs(deltaY)) {
        event.preventDefault();
        lastSwipeAt = Date.now();
        show(deltaX > 0 ? current - 1 : current + 1);
      }
    });

    closeButton.addEventListener('click', () => dialog.close());

    dialog.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowLeft') {
        event.preventDefault();
        show(current - 1);
      }
      if (event.key === 'ArrowRight') {
        event.preventDefault();
        show(current + 1);
      }
    });

    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) {
        dialog.close();
      }
    });

    dialog.addEventListener('close', () => {
      image.src = '';
      counter.textContent = '';
    });
  }
</script>
