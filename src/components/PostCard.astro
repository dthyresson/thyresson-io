---
import { Image } from '@unpic/astro';
import FormattedDate from './FormattedDate.astro';

interface Props {
  post: {
    id: string;
    data: {
      title: string;
      description: string;
      heroImage: {
        src: string;
        width: number;
        height: number;
        format: string;
      };
      tags: string[];
      pubDate: Date;
    };
  };
  featured?: boolean;
}

const { post, featured = false } = Astro.props;
---

{
  post.data.heroImage && (
    <Image
      width={1024}
      height={576}
      src={post.data.heroImage.src}
      alt=""
      class="rounded-lg shadow-lg"
    />
  )
}
{featured ? (
  <h1 class="text-4xl md:text-5xl font-bold leading-tight my-4">{post.data.title}</h1>
) : (
  <h2 class="text-2xl font-bold my-2">{post.data.title}</h2>
)}
{featured ? (
  <p class="text-xl text-gray-500 my-2">{post.data.description}</p>
) : (
  <h2 class="text-lg text-gray-500 my-2">{post.data.description}</h2>
)}
<div class="flex justify-between items-center pt-4">
  <div class="flex flex-wrap gap-2">
    {
      post.data.tags.map((tag) => (
        <a
          href={`/blog/tag/${encodeURIComponent(tag)}`}
          class="p-1 bg-white hover:bg-gray-50 border border-gray-200 rounded-lg text-sm text-gray-500 hover:text-gray-900 hover:underline"
        >
          {tag}
        </a>
      ))
    }
  </div>
  <p class="text-sm whitespace-nowrap ml-auto">
    🗓️ <FormattedDate date={post.data.pubDate} />
  </p>
</div>
